<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Price Lookup</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F6F2E9;
    --ink:#20232B;
    --accent:#C1451B;
    --accent-2:#2F6F5E;
    --muted:#8A8272;
    --line:#DBD3BF;
    --card:#FFFDF8;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  header{
    padding:28px 20px 20px;
    border-bottom:2px solid var(--ink);
    background:var(--paper);
    position:sticky;
    top:0;
    z-index:5;
  }
  header .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--accent-2);
    margin:0 0 4px;
  }
  h1{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:34px;
    text-transform:uppercase;
    letter-spacing:.01em;
    margin:0 0 14px;
    line-height:0.95;
  }
  .search-wrap{position:relative;}
  #search{
    width:100%;
    font-family:'IBM Plex Mono',monospace;
    font-size:16px;
    padding:14px 16px;
    border:2px solid var(--ink);
    border-radius:2px;
    background:var(--card);
    color:var(--ink);
    outline:none;
  }
  #search:focus{border-color:var(--accent);}
  .meta-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:10px;
    font-family:'IBM Plex Mono',monospace;
    font-size:11.5px;
    color:var(--muted);
  }
  .meta-row button{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    letter-spacing:.04em;
    text-transform:uppercase;
    background:none;
    border:1px solid var(--muted);
    color:var(--ink);
    padding:5px 10px;
    border-radius:2px;
    cursor:pointer;
  }
  .meta-row button:hover{border-color:var(--ink);}

  main{padding:18px 16px 60px; max-width:720px; margin:0 auto;}

  #upload-panel{
    background:var(--card);
    border:2px dashed var(--line);
    border-radius:6px;
    padding:36px 20px;
    text-align:center;
    margin-top:12px;
  }
  #upload-panel h2{
    font-family:'Barlow Condensed',sans-serif;
    font-size:24px;
    text-transform:uppercase;
    margin:0 0 8px;
  }
  #upload-panel p{color:var(--muted); font-size:14px; margin:0 0 20px; line-height:1.5;}
  .file-btn{
    display:inline-block;
    font-family:'IBM Plex Mono',monospace;
    font-weight:600;
    font-size:13px;
    letter-spacing:.05em;
    text-transform:uppercase;
    background:var(--accent);
    color:#FFFDF8;
    padding:13px 24px;
    border-radius:3px;
    cursor:pointer;
    border:none;
  }
  #file-input{display:none;}
  #status{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--accent-2);
    margin-top:14px;
    min-height:16px;
  }

  #results{margin-top:18px; display:flex; flex-direction:column; gap:12px;}

  .tag{
    position:relative;
    background:var(--card);
    border:1.5px solid var(--ink);
    border-radius:4px;
    padding:14px 16px 14px 30px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
  }
  .tag::before{
    content:'';
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    width:9px;
    height:9px;
    border-radius:50%;
    background:var(--paper);
    border:1.5px solid var(--ink);
  }
  .tag-info{min-width:0;}
  .tag-num{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    letter-spacing:.06em;
    color:var(--accent-2);
    text-transform:uppercase;
    margin:0 0 3px;
  }
  .tag-desc{
    font-size:14.5px;
    font-weight:600;
    margin:0 0 2px;
    line-height:1.25;
  }
  .tag-short{
    font-size:12.5px;
    color:var(--muted);
    margin:0;
    line-height:1.3;
  }
  .tag-price{
    flex-shrink:0;
    font-family:'Barlow Condensed',sans-serif;
    font-weight:800;
    font-size:23px;
    color:var(--accent);
    background:#FBEADF;
    border-radius:999px;
    padding:6px 14px;
    white-space:nowrap;
  }

  #empty{
    text-align:center;
    color:var(--muted);
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    padding:40px 10px;
  }
  .count-pill{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:var(--muted);
  }
</style>
</head>
<body>

<header>
  <p class="eyebrow">// Catalog Lookup</p>
  <h1>Price Finder</h1>
  <div class="search-wrap">
    <input id="search" type="text" placeholder="Search product number or name…" autocomplete="off">
  </div>
  <div class="meta-row">
    <span class="count-pill" id="count-pill"></span>
    <button id="reload-btn" style="display:none;">Load New File</button>
  </div>
</header>

<main>
  <div id="upload-panel">
    <h2>Load your price list</h2>
    <p>Upload the Excel file once — Product Number, Product Line Description,<br>Product Short Description, Unit Price. It's saved on this phone/browser,<br>so you won't need to upload it again next time.</p>
    <label class="file-btn" for="file-input">Choose Excel File</label>
    <input type="file" id="file-input" accept=".xlsx,.xls,.csv">
    <div id="status"></div>
  </div>

  <div id="results"></div>
  <div id="empty" style="display:none;">No matches. Try a different product number or keyword.</div>
</main>

<script>
const STORAGE_KEY = 'priceLookupData_v1';
let allRows = [];

const fileInput = document.getElementById('file-input');
const uploadPanel = document.getElementById('upload-panel');
const statusEl = document.getElementById('status');
const searchEl = document.getElementById('search');
const resultsEl = document.getElementById('results');
const emptyEl = document.getElementById('empty');
const reloadBtn = document.getElementById('reload-btn');
const countPill = document.getElementById('count-pill');

function normalizeHeader(h){
  return String(h||'').trim().toLowerCase();
}

function mapRows(json){
  return json.map(r => {
    let num, lineDesc, shortDesc, price;
    for(const key in r){
      const k = normalizeHeader(key);
      if(k.includes('product number') || k === 'sku' || k.includes('item number')) num = r[key];
      else if(k.includes('line description')) lineDesc = r[key];
      else if(k.includes('short description')) shortDesc = r[key];
      else if(k.includes('unit price') || k === 'price') price = r[key];
    }
    return {
      num: num !== undefined ? String(num).trim() : '',
      lineDesc: lineDesc !== undefined ? String(lineDesc).trim() : '',
      shortDesc: shortDesc !== undefined ? String(shortDesc).trim() : '',
      price: price !== undefined ? price : ''
    };
  }).filter(r => r.num || r.lineDesc || r.shortDesc);
}

function formatPrice(p){
  if(p === '' || p === undefined || p === null) return '—';
  const n = Number(p);
  if(isNaN(n)) return String(p);
  return '₹' + n.toLocaleString('en-IN', {maximumFractionDigits:2});
}

function renderRows(rows){
  resultsEl.innerHTML = '';
  if(rows.length === 0){
    emptyEl.style.display = 'block';
    countPill.textContent = '';
    return;
  }
  emptyEl.style.display = 'none';
  countPill.textContent = rows.length + (rows.length === allRows.length ? ' items loaded' : ' matches');
  const frag = document.createDocumentFragment();
  rows.slice(0, 200).forEach(r => {
    const div = document.createElement('div');
    div.className = 'tag';
    div.innerHTML = `
      <div class="tag-info">
        <p class="tag-num">${escapeHtml(r.num)}</p>
        <p class="tag-desc">${escapeHtml(r.lineDesc)}</p>
        ${r.shortDesc ? `<p class="tag-short">${escapeHtml(r.shortDesc)}</p>` : ''}
      </div>
      <div class="tag-price">${formatPrice(r.price)}</div>
    `;
    frag.appendChild(div);
  });
  resultsEl.appendChild(frag);
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function filterAndRender(){
  const q = searchEl.value.trim().toLowerCase();
  if(!q){ renderRows(allRows); return; }
  const filtered = allRows.filter(r =>
    r.num.toLowerCase().includes(q) ||
    r.lineDesc.toLowerCase().includes(q) ||
    r.shortDesc.toLowerCase().includes(q)
  );
  renderRows(filtered);
}

function loadFromStorage(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return false;
    allRows = JSON.parse(raw);
    if(!Array.isArray(allRows) || allRows.length === 0) return false;
    uploadPanel.style.display = 'none';
    reloadBtn.style.display = 'inline-block';
    renderRows(allRows);
    return true;
  }catch(e){ return false; }
}

function handleFile(file){
  statusEl.textContent = 'Reading file…';
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, {type:'array'});
      const sheet = wb.Sheets[wb.SheetNames[0]];
      const json = XLSX.utils.sheet_to_json(sheet, {defval:''});
      allRows = mapRows(json);
      if(allRows.length === 0){
        statusEl.textContent = 'Could not find matching columns. Check the file and try again.';
        return;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(allRows));
      statusEl.textContent = `Loaded ${allRows.length} products.`;
      uploadPanel.style.display = 'none';
      reloadBtn.style.display = 'inline-block';
      renderRows(allRows);
    }catch(err){
      statusEl.textContent = 'Error reading file: ' + err.message;
    }
  };
  reader.readAsArrayBuffer(file);
}

fileInput.addEventListener('change', (e) => {
  if(e.target.files[0]) handleFile(e.target.files[0]);
});

reloadBtn.addEventListener('click', () => {
  uploadPanel.style.display = 'block';
  reloadBtn.style.display = 'none';
  resultsEl.innerHTML = '';
  countPill.textContent = '';
  statusEl.textContent = '';
});

searchEl.addEventListener('input', filterAndRender);

loadFromStorage();
</script>

</body>
</html>
